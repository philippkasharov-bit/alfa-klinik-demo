---
// Navy "by the numbers" band, adapted from the Baseline template's Stats section.
// Every figure is derived from data already on the site — no new claims:
//   services.length          → направлений стоматологии (data/services.ts)
//   otherDepartments.length  → направлений центра помимо стоматологии (data/about.ts)
//   «Отсрочка оплаты от 1 до 3 месяцев» (data/trust.ts, shown in TrustSection)
//   clinic.hours[0]          → часы приёма (data/clinic.ts)
import { services } from '../../data/services';
import { otherDepartments } from '../../data/about';
import { clinic } from '../../data/clinic';

const stats = [
  { value: String(services.length), label: 'направлений стоматологии в одной клинике' },
  { value: String(otherDepartments.length), label: 'медицинских направлений центра помимо стоматологии' },
  { value: '1–3', label: 'месяца отсрочки оплаты лечения' },
  { value: clinic.hours[0].time.replace(/:00/g, '').replace(/\s/g, ''), label: 'часы приёма, воскресенье — выходной' },
];
---
<section class="stats" aria-labelledby="stats-title">
  <div class="container container--wide">
    <h2 id="stats-title" class="stats__title" data-reveal="slide">Клиника в&nbsp;цифрах</h2>
    <dl class="stats__grid">
      {stats.map((s, i) => (
        <div class="stats__cell" data-reveal="slide" style={`--reveal-delay: ${i + 1}`}>
          <dt class="visually-hidden">{s.label}</dt>
          <dd>
            <span class="stats__value t-num">{s.value}</span>
            <span class="stats__label" aria-hidden="true">{s.label}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats {
    margin: var(--space-2);
    padding-block: var(--section-sm);
    border-radius: var(--radius-md);
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }
  .stats__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: var(--weight-medium);
    font-size: clamp(2.25rem, 1.4rem + 3vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
    margin: var(--space-8) 0 0;
  }
  .stats__cell { padding-top: var(--space-4); border-top: 1px solid rgb(255 255 255 / 0.2); }
  .stats__cell dd { margin: 0; display: grid; gap: var(--space-3); }
  .stats__value {
    font-size: clamp(3rem, 2rem + 3.6vw, 4.5rem);
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .stats__label { max-width: 22ch; font-size: var(--size-small); color: rgb(255 255 255 / 0.74); }
  @media (min-width: 64rem) {
    .stats__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
