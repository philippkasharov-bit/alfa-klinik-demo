---
// Homepage featured offer. Content comes only from data/promotions.ts
// (source: alfaklinik.ru/skidki.htm). Dark "inverse" band for contrast —
// same palette, no new colours.
import Button from '../ui/Button.astro';
import { clinic } from '../../data/clinic';
import { formatNumber as rub } from '../../utils/format';
import { promotions, promoCategories, promoValidity } from '../../data/promotions';

interface Props {
  promoId?: string;
  /** Editorial headline split: plain part + italic part */
  headline?: { lead: string; accent: string };
}
const {
  promoId = 'cleaning',
  headline = { lead: 'Комплексная чистка', accent: 'всей полости рта' },
} = Astro.props;

const p = promotions.find((x) => x.id === promoId)!;
const category = promoCategories.find((c) => c.id === p.category)?.label;
---
<section class="offer section--inverse" aria-labelledby="offer-title">
  <div class="container container--wide offer__grid">
    <div class="offer__content">
      <p class="offer__label" data-reveal="fade">
        <span>Акция</span>
        <span class="offer__label-sep" aria-hidden="true"></span>
        <span>{category}</span>
      </p>

      <h2 id="offer-title" class="offer__title" data-reveal="slide">
        {headline.lead} <em>{headline.accent}</em>
      </h2>

      <p class="offer__description" data-reveal="slide" style="--reveal-delay: 1">
        {p.description} Ультразвук, Air-Flow, обработка дёсен, полировка и&nbsp;фторирование.
      </p>

      <div class="offer__price-row" data-reveal="slide" style="--reveal-delay: 2">
        <p class="offer__price t-num">
          {p.price != null && <>{rub(p.price)}<span class="offer__currency">₽</span></>}
        </p>
        <div class="offer__price-meta">
          {p.saving && <p class="chip-saving offer__saving">{p.saving}</p>}
          {p.comparison && <p class="offer__compare">{p.comparison}. По&nbsp;данным клиники.</p>}
        </div>
      </div>

      <div class="offer__includes" data-reveal="slide" style="--reveal-delay: 3">
        <p class="offer__includes-title">Что входит</p>
        <ul role="list">
          {p.includes.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="offer__actions" data-reveal="slide" style="--reveal-delay: 3">
        <Button href={clinic.phone.href} arrow block="mobile" data-book aria-label={`Записаться по акции по телефону ${clinic.phone.display}`}>Записаться по акции</Button>
        <a class="offer__phone t-num" href={clinic.phone.href}>{clinic.phone.display}</a>
        <Button href="/skidki" variant="text">Все акции</Button>
      </div>

      <p class="offer__validity" data-reveal="fade" style="--reveal-delay: 4">{promoValidity.label}</p>
    </div>

    <div class="offer__visual" data-reveal="image">
      <div class="offer__image" role="img" aria-label="Заглушка: фотография гигиенической процедуры">
        <span class="offer__image-grid" aria-hidden="true"></span>
        <span class="offer__image-label">
          <span class="t-label offer__image-tag">Заглушка · фото предоставит клиника</span>
          <span class="offer__image-title">Гигиеническая процедура</span>
        </span>
      </div>

    </div>
  </div>
</section>

<style>
  .offer {
    --offer-fg: var(--color-text-inverse);
    --offer-muted: color-mix(in srgb, var(--color-text-inverse) 70%, transparent);
    --offer-line: var(--color-border-inverse);
    --offer-accent: var(--color-bg-accent); /* #E5EFEC — light sage reads on ink */

    position: relative;
    padding-block: var(--section-lg);
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--color-bg-inverse) 96%, var(--color-text-inverse)) 0%,
      var(--color-bg-inverse) 100%);
    color: var(--offer-fg);
    overflow-x: clip;
  }
  .offer :global(:focus-visible) { outline-color: var(--offer-fg); }

  /* ---------- Mobile first ---------- */
  .offer__grid { display: grid; gap: var(--space-8); }
  .offer__content { display: grid; align-content: start; }

  .offer__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    font-size: var(--size-label);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.01em;
    color: var(--offer-muted);
  }
  .offer__label-sep { width: 2rem; height: 1px; background: currentColor; }

  .offer__title {
    margin: 0;
    max-width: 15ch;
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: clamp(2.75rem, 1.6rem + 4.4vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  .offer__title em { display: block; font-style: italic; color: var(--offer-accent); }

  .offer__description {
    max-width: 38ch;
    margin-top: var(--space-5);
    font-size: var(--size-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--offer-muted);
  }

  /* Price: the typographic centrepiece */
  .offer__price-row {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--offer-line);
  }
  .offer__price {
    display: flex;
    align-items: baseline;
    gap: 0.12em;
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: clamp(4.5rem, 3rem + 7vw, 9rem);
    line-height: 0.85;
    letter-spacing: -0.035em;
    font-variant-numeric: lining-nums;
  }
  .offer__currency {
    font-size: 0.42em;
    letter-spacing: 0;
    color: var(--offer-muted);
  }
  .offer__price-meta { display: grid; gap: var(--space-1); align-content: end; }
  .offer__saving { margin-bottom: 0.2rem; }
  .offer__compare { font-size: var(--size-small); color: var(--offer-muted); max-width: 32ch; }

  .offer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-7);
  }
  .offer__phone {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-size: var(--size-body);
    font-weight: var(--weight-medium);
  }
  .offer__phone:hover { color: var(--offer-accent); }
  .offer__validity {
    margin-top: var(--space-5);
    font-size: var(--size-small);
    color: var(--offer-muted);
  }

  /* ---------- Visual ---------- */
  .offer__visual {
    position: relative;
    display: grid;
    /* full-bleed image on mobile */
    margin-inline: calc(var(--gutter) * -1);
  }
  .offer__image {
    position: relative;
    display: grid;
    align-items: end;
    aspect-ratio: 4 / 3;
    padding: var(--space-5) var(--gutter);
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 80% 10%, color-mix(in srgb, var(--color-accent) 55%, transparent), transparent 70%),
      linear-gradient(170deg, color-mix(in srgb, var(--color-accent) 40%, var(--color-bg-inverse)), var(--color-bg-inverse));
  }
  /* Fine architectural grid — reads as a considered placeholder, not decoration */
  .offer__image-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--offer-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--offer-line) 1px, transparent 1px);
    background-size: 25% 33.333%;
    mask-image: linear-gradient(to bottom, #000 30%, transparent 95%);
  }
  /* Caption — same structure and type as .hero__placeholder-text; colours use the band's inverse tokens */
  .offer__image-label {
    position: relative;
    display: grid;
    gap: var(--space-2);
    max-width: 30rem;
    padding-top: var(--space-4);
    border-top: 1px dashed color-mix(in srgb, var(--offer-fg) 45%, transparent);
  }
  .offer__image-tag { color: var(--offer-muted); }        /* .t-label: 13px / 500 / tracking-label, no uppercase */
  .offer__image-title {                                    /* = .hero__placeholder-title */
    font-family: var(--font-display);
    font-size: var(--size-h3);
    line-height: 1.2;
    color: var(--offer-fg);
  }

  .offer__includes {
    margin-top: var(--space-7);
    min-width: 0;
  }
  .offer__includes-title {
    margin-bottom: var(--space-3);
    font-size: var(--size-label);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.01em;
    color: var(--offer-muted);
  }
  .offer__includes ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--size-small);
  }
  .offer__includes li {
    display: flex;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--offer-line);
  }
  .offer__includes li::before {
    content: "";
    flex: none;
    width: 0.75rem;
    height: 1px;
    margin-top: 0.7em;
    background: var(--offer-accent);
  }

  /* Phones: the description already names the procedures; keep the image, drop the list */
  @media (max-width: 39.99rem) {
    .offer__includes { display: none; }
    .offer__image { aspect-ratio: 16 / 10; }
    .offer__grid { gap: var(--space-7); }
    .offer__price-row { margin-top: var(--space-6); padding-top: var(--space-5); }
    .offer__actions { margin-top: var(--space-6); }
  }

  /* ---------- Tablet ---------- */
  @media (min-width: 40rem) {
    .offer__price-row { grid-template-columns: auto 1fr; align-items: end; column-gap: var(--space-6); }
    .offer__includes ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); }
    .offer__includes li { min-width: 0; overflow-wrap: break-word; }
  }

  /* ---------- Desktop: text (incl. "Что входит") left, image fills its own column right ---------- */
  @media (min-width: 64rem) {
    .offer__grid {
      /* Same ratio and gap as About / Technology */
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--col-gap);
      align-items: stretch;
    }
    .offer__content, .offer__visual { min-width: 0; }

    .offer__visual {
      margin: 0;
      width: 100%;
    }
    .offer__image {
      width: 100%;
      aspect-ratio: auto;
      min-height: 34rem;
      height: 100%;
      padding: var(--space-7);
      border-radius: var(--radius-sm);
    }
    .offer__includes ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); }
  }
</style>
