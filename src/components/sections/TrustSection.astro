---
// "Why trust this clinic" — qualitative, source-backed. No statistics:
// the original site doesn't publish any.
import Section from '../layout/Section.astro';
import { trustPillars, materials, commitments } from '../../data/trust';
---
<Section join width="wide" labelledby="trust-title" class="trust">
  <header class="trust__head">
    <p class="t-label" data-reveal="fade">Подход клиники</p>
    <h2 id="trust-title" class="t-h2 trust__title" data-reveal="slide">
      Понятный план лечения, <em>фиксированная стоимость</em>
    </h2>
    <p class="t-body-lg t-muted trust__intro" data-reveal="slide" style="--reveal-delay: 1">
      Решение о лечении остаётся за пациентом — наша задача дать для него
      всю информацию: диагностику, план, стоимость и сроки.
    </p>
  </header>

  <ol class="trust__pillars" role="list">
    {trustPillars.map((p, i) => (
      <li class="trust__pillar" data-reveal="slide" style={`--reveal-delay: ${i}`}>
        <p class="trust__meta">
          <span class="t-label">{p.label}</span>
        </p>
        <h3 class="t-h3">{p.title}</h3>
        <p class="t-small t-muted">{p.text}</p>
      </li>
    ))}
  </ol>

  <div class="trust__materials" data-reveal="fade">
    <p class="t-label">Производители материалов и оборудования</p>
    <ul class="trust__brands" role="list">
      {materials.map((m) => (
        <li>
          <span class="trust__brand">{m.name}</span>
          <span class="trust__brand-note">{m.use}{m.origin && ` · ${m.origin}`}</span>
        </li>
      ))}
    </ul>
  </div>

  <ul class="trust__commitments" role="list" data-reveal="fade">
    {commitments.map((c) => <li>{c}</li>)}
  </ul>
</Section>

<style>
  /* ---------- Head ---------- */
  .trust__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .trust__title { max-width: 22ch; font-size: var(--size-h1); line-height: 1.02; letter-spacing: var(--tracking-display); }
  .trust__title em { display: inline; font-style: normal; } /* one continuous phrase — split-italic is reserved for hero / offer / final */
  .trust__intro { max-width: 40ch; }

  @media (min-width: 64rem) {
    .trust__head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: auto auto;
      column-gap: var(--col-gap);
      row-gap: var(--space-4);
      align-items: end;
      margin-bottom: var(--space-9);
    }
    .trust__head .t-label { grid-column: 1 / -1; grid-row: 1; }
    .trust__title { grid-column: 1 / -1; grid-row: 2; }
    .trust__intro { grid-column: 2; grid-row: 3; margin-top: var(--space-5); }
  }

  /* ---------- Pillars: open columns with a top hairline, no boxes ---------- */
  .trust__pillars {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trust__pillar {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .trust__pillar .t-small { max-width: 36ch; }
  .trust__meta {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .trust__meta .t-label { color: var(--color-text-accent); font-weight: var(--weight-semibold); }

  @media (min-width: 48rem) {
    .trust__pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }
    /* Meta / title / text share row tracks across pillars — titles that wrap don't stagger their neighbours */
    @supports (grid-template-rows: subgrid) {
      .trust__pillar { grid-row: span 3; grid-template-rows: subgrid; }
    }
    .trust__pillar { padding-bottom: var(--space-7); }
  }
  @media (min-width: 64rem) {
    .trust__pillars { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    /* Darker rule on top of the row reads as one architectural line */
    .trust__pillar { border-top-color: var(--color-text); }
  }

  /* ---------- Materials: typographic list, not logos ---------- */
  .trust__materials {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  /* "As-featured-in" strip: hairline-framed cells, one shared baseline, muted type */
  .trust__brands {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--color-border);
  }
  .trust__brands li {
    display: grid;
    grid-template-rows: auto auto;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4);
    border-left: 1px solid var(--color-border);
  }
  /* Phones: 2 columns — no divider at row start, hairline between rows */
  .trust__brands li:nth-child(2n+1) { border-left: 0; padding-left: 0; }
  .trust__brands li:nth-child(n+3) { border-top: 1px solid var(--color-border); }

  .trust__brand {
    font-family: var(--font-display);
    font-size: var(--size-title-sm);
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: -0.005em;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-text) 72%, var(--color-bg));
  }
  .trust__brand-note {
    font-size: var(--size-label);
    font-weight: var(--weight-regular, 400);
    letter-spacing: 0.02em;
    line-height: 1.3;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* Tablet: 4 columns */
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .trust__brands { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .trust__brands li:nth-child(n) { border-left: 1px solid var(--color-border); padding-left: var(--space-4); border-top: 0; }
    .trust__brands li:nth-child(4n+1) { border-left: 0; padding-left: 0; }
    .trust__brands li:nth-child(n+5) { border-top: 1px solid var(--color-border); }
  }
  /* Desktop: one row, full-height hairlines between every entry */
  @media (min-width: 64rem) {
    .trust__brands {
      grid-template-columns: repeat(7, auto);
      justify-content: space-between;
    }
    .trust__brands li:nth-child(n) {
      padding: var(--space-5) clamp(1rem, -0.5rem + 1.6vw, 2rem);
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }
    .trust__brands li:first-child { border-left: 0; padding-left: 0; }
    .trust__brands li:last-child { padding-right: 0; }
  }

  @media (max-width: 47.99rem) {
    .trust__head { margin-bottom: var(--space-6); }
    .trust__pillars { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-4); }
    .trust__pillar { padding-block: var(--space-4) var(--space-5); gap: var(--space-2); }
    .trust__pillar .t-h3 { font-size: 1.125rem; }
    .trust__pillar .t-small { line-height: 1.5; } /* keeps the 16px secondary size — no sub-floor prose */
    .trust__materials { margin-top: var(--space-5); padding-top: var(--space-5); gap: var(--space-3); }
    .trust__commitments { margin-top: var(--space-6); }
  }
  @media (max-width: 22.49rem) {
    .trust__pillars { grid-template-columns: 1fr; }
  }

  @media (max-width: 39.99rem) {
    .trust__brand { white-space: normal; }
  }

  /* ---------- Commitments ---------- */
  .trust__commitments {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--size-small);
    font-weight: var(--weight-medium);
  }
  .trust__commitments li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .trust__commitments li::before {
    content: "";
    flex: none;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  @media (min-width: 48rem) {
    .trust__commitments { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-7); }
  }
</style>
