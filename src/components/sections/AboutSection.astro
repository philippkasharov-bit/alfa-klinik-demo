---
// About Alfa-Klinik — two-column editorial layout. Facts only (see data/about.ts).
import Section from '../layout/Section.astro';
import Button from '../ui/Button.astro';
import { about, otherDepartments } from '../../data/about';
import { clinic } from '../../data/clinic';

interface Props {
  image?: { src: string; alt: string; width: number; height: number };
}
const { image } = Astro.props;
---
<Section join width="wide" labelledby="about-title" class="about">
  <div class="about__grid">
    <figure class="about__media">
      <div class="about__frame" data-reveal="image">
        {image ? (
          <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
        ) : (
          <div class="about__plate">
            <p class="about__plate-num t-num" aria-hidden="true">{otherDepartments.length}</p>
            <p class="about__plate-lead">направлений центра помимо стоматологии</p>
            <ul class="about__plate-list" role="list">
              {otherDepartments.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        )}
      </div>
      <figcaption class="about__caption">
        <span class="t-num">{clinic.address}</span>
      </figcaption>
    </figure>

    <div class="about__content">

      <h2 id="about-title" class="t-h2 about__title" data-reveal="slide">
        {about.heading.lead}{' '}<em>{about.heading.accent}</em>
      </h2>

      <p class="t-body-lg about__text" data-reveal="slide" style="--reveal-delay: 1">
        {about.paragraph}
      </p>

      <ol class="about__points" role="list">
        {about.points.map((pt, i) => (
          <li data-reveal="slide" style={`--reveal-delay: ${i + 2}`}>
            <div>
              <h3 class="about__point-title">{pt.title}</h3>
              <p class="t-small t-muted">{pt.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="about__footer" data-reveal="fade">
        <Button href="/contacts" variant="secondary" arrow block="mobile">Контакты и адрес</Button>
      </div>
    </div>
  </div>
</Section>

<style>
  /* ---------- Mobile first: image → text → points ---------- */
  .about__grid { display: grid; gap: var(--space-7); }

  .about__media { margin: 0; display: grid; gap: var(--space-3); }
  .about__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background:
      radial-gradient(70% 55% at 30% 20%, color-mix(in srgb, var(--color-surface) 80%, transparent) 0%, transparent 70%),
      linear-gradient(160deg, var(--color-bg-accent) 0%, var(--color-bg-subtle) 100%);
  }
  .about__frame img { width: 100%; height: 100%; object-fit: cover; }

  /* Typographic plate: the centre's other departments, set as an index.
     Stands in for interior photography until the clinic supplies real photos. */
  .about__plate {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto auto 1fr;
    align-content: start;
    padding: var(--space-6) var(--space-5);
    color: var(--color-text);
  }
  .about__plate-num {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: clamp(6rem, 3rem + 10vw, 11rem);
    line-height: 0.82;
    letter-spacing: -0.03em;
    color: var(--color-text-accent);
  }
  .about__plate-lead {
    margin: var(--space-3) 0 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: var(--size-h3);
    line-height: 1.2;
  }
  .about__plate-list {
    align-self: end;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) 0;
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    font-size: var(--size-label);
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  .about__plate-list li:not(:last-child)::after {
    content: "";
    display: inline-block;
    width: 3px;
    height: 3px;
    margin: 0 0.6em 0.2em;
    border-radius: 50%;
    background: var(--color-accent);
    vertical-align: middle;
  }

  .about__caption {
    font-size: var(--size-label);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .about__content { display: grid; align-content: start; }
  .about__title { margin-top: var(--space-4); max-width: 22ch; }
  .about__title em { display: inline; font-style: normal; } /* one continuous phrase — split-italic is reserved for hero / offer / final */
  .about__text { margin-top: var(--space-5); max-width: 46ch; }

  .about__points {
    display: grid;
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-text);
  }
  .about__points li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .about__point-title {
    margin: 0 0 var(--space-1);
    font-size: var(--size-body);
    font-weight: var(--weight-semibold);
    line-height: 1.35;
  }
  .about__points .t-small { max-width: 48ch; }


  .about__footer {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    margin-top: var(--space-7);
  }

  @media (max-width: 39.99rem) {
    .about__frame { aspect-ratio: 4 / 3; }
    .about__points li { padding-block: var(--space-4); }
    .about__points { margin-top: var(--space-6); }
    .about__footer { margin-top: var(--space-6); }
  }

  /* Tablet: landscape crop so the image doesn't fill a whole screen */
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .about__frame { aspect-ratio: 3 / 2; }
  }

  /* ---------- Desktop: image left (5), text right (6) ---------- */
  @media (min-width: 64rem) {
    .about__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--col-gap);
      align-items: start;
    }
    /* Image stays in view while the text column scrolls past */
    .about__media {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }
    .about__frame {
      aspect-ratio: auto;
      height: min(calc(100svh - var(--header-height) - var(--space-6) * 2 - 2.5rem), 40rem);
      min-height: 26rem;
    }
    .about__plate { padding: var(--space-7); }
    .about__content { padding-top: var(--space-6); }
  }
</style>
