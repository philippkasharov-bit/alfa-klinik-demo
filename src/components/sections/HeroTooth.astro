---
// Hero visual: generated 3D molar (public/models/tooth.glb, meshopt + WebP, ~400 KB).
// A static transparent poster paints first; <model-viewer> is fetched from a pinned CDN
// only on ≥600px viewports, after window load + idle, and never on Save-Data.
// Under 600px (and without JS) the poster is the whole experience.
---
<div class="tooth" data-tooth>
  <img
    class="tooth__poster"
    src="/models/tooth-poster.webp"
    alt=""
    width="800"
    height="800"
    loading="eager"
    decoding="async"
  />
  <model-viewer
    class="tooth__viewer"
    data-src="/models/tooth.glb"
    alt="Трёхмерная модель зуба — можно повернуть мышью или пальцем"
    camera-controls
    disable-zoom
    disable-pan
    interaction-prompt="none"
    touch-action="pan-y"
    camera-orbit="-25deg 78deg auto"
    min-camera-orbit="auto 55deg auto"
    max-camera-orbit="auto 100deg auto"
    rotation-per-second="10deg"
    auto-rotate-delay="0"
    environment-image="neutral"
    tone-mapping="neutral"
    exposure="1.1"
    shadow-intensity="0.45"
    shadow-softness="1"
  ></model-viewer>
  <ol class="tooth__notes" role="list" aria-label="Отделения клиники">
    <li style="--x: 4%; --y: 8%"><span>01</span> Диагностика<small>3D-сканирование, визиография</small></li>
    <li style="--x: 4%; --y: 56%"><span>02</span> Гигиена<small>комплексная чистка, 7 процедур</small></li>
    <li style="--x: 60%; --y: 84%"><span>03</span> Протезирование<small>DUCERAM · VITA · Noritake</small></li>
  </ol>
  <p class="tooth__cap"><span>Рис. 1 — моляр, вид сбоку</span><span>Модель можно повернуть</span></p>
</div>

<script>
  // Pinned: bump deliberately, never float. model-viewer ≈ 290 KB gz incl. three.js.
  // (4.3.x ships stray debug console.logs — skip it.)
  const MODEL_VIEWER = 'https://cdn.jsdelivr.net/npm/@google/model-viewer@4.4.0/dist/model-viewer.min.js';
  // tooth.glb uses EXT_meshopt_compression; model-viewer loads this as a classic script
  // (0.25 is the last release with the UMD build that defines a global MeshoptDecoder).
  const MESHOPT_DECODER = 'https://cdn.jsdelivr.net/npm/meshoptimizer@0.25.0/meshopt_decoder.js';
  type MVConfig = { meshoptDecoderLocation?: string };
  const w = window as unknown as { ModelViewerElement?: MVConfig };
  w.ModelViewerElement = { ...w.ModelViewerElement, meshoptDecoderLocation: MESHOPT_DECODER };

  const root = document.querySelector<HTMLElement>('[data-tooth]');
  const viewer = root?.querySelector<HTMLElement>('model-viewer');
  const wide = window.matchMedia('(min-width: 37.5rem)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  const syncMotion = () => viewer?.toggleAttribute('auto-rotate', !reduced.matches);

  let started = false;
  function start() {
    if (started || !root || !viewer || !wide.matches) return;
    started = true;
    syncMotion();
    reduced.addEventListener('change', syncMotion);
    viewer.addEventListener('load', () => {
      root.classList.add('is-3d');
      // After the cross-fade, drop the poster so it isn't a hidden raster in the layer tree
      const poster = root.querySelector<HTMLImageElement>('.tooth__poster');
      if (poster) setTimeout(() => { poster.hidden = true; }, 600);
    }, { once: true });
    viewer.setAttribute('src', viewer.dataset.src!);
    const s = document.createElement('script');
    s.type = 'module';
    s.src = MODEL_VIEWER;
    s.crossOrigin = 'anonymous';
    document.head.append(s);
  }

  // Wait for LCP-critical work, then idle — the 3D layer is decoration, not content.
  function schedule() {
    const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
    idle(start);
  }

  if (root && viewer && !saveData) {
    if (wide.matches) {
      if (document.readyState === 'complete') schedule();
      else window.addEventListener('load', schedule, { once: true });
    }
    // Phone rotated / window widened past 600px later on.
    wide.addEventListener('change', () => wide.matches && schedule());
  }
</script>

<style>
  .tooth {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    /* Soft sage halo behind the porcelain — reads as light, not as a backdrop */
    /* Atlas plate: paper sheet with a quarter grid, the specimen sits on it */
    background:
      linear-gradient(var(--color-border) 1px, transparent 1px) 0 0 / 100% 25%,
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px) 0 0 / 25% 100%,
      var(--color-bg-subtle);
  }
  /* A square stage, centred in the part of the panel that sits above the fold
     (on desktop the panel overhangs into the next section). */
  .tooth__poster,
  .tooth__viewer {
    grid-area: 1 / 1;
    width: min(78%, 36rem, 62svh);
    aspect-ratio: 1;
    height: auto;
  }
  @media (min-width: 64rem) {
    .tooth { place-items: start center; padding-top: clamp(var(--space-6), 9svh, var(--space-8)); }
  }
  .tooth__poster {
    object-fit: contain;
    transition: opacity var(--duration-base) var(--ease-standard);
  }
  .tooth__viewer {
    display: none;
    --poster-color: transparent;
    --progress-bar-height: 0px;
    background: transparent;
  }
  .tooth__viewer:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -4px;
  }
  @media (min-width: 37.5rem) {
    .tooth__viewer:defined { display: block; }
  }
  /* Model has rendered its first frame — retire the poster underneath */
  .tooth.is-3d .tooth__poster { opacity: 0; }

  /* Callouts: hairline leader + mono figure number, like an atlas plate */
  .tooth__notes { display: none; }
  .tooth__cap {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--color-text);
    background: var(--color-bg);
    font: var(--weight-regular) 0.75rem/1.3 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }
  @media (max-width: 37.49rem) { .tooth__cap span:last-child { display: none; } }
  @media (min-width: 64rem) {
    .tooth__notes {
      display: block;
      position: absolute;
      inset: 0;
      margin: 0;
      padding: 0;
      list-style: none;
      pointer-events: none;
    }
    .tooth__notes li {
      position: absolute;
      left: var(--x);
      top: var(--y);
      padding-left: 4.25rem;
      font: var(--weight-medium) 0.8125rem/1.35 var(--font-sans);
      color: var(--color-text);
    }
    .tooth__notes li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.7em;
      width: 3.5rem;
      height: 1px;
      background: var(--color-accent);
    }
    .tooth__notes span { font-family: var(--font-mono); color: var(--color-text-accent); margin-right: 0.4em; }
    .tooth__notes small { display: block; font: var(--weight-regular) 0.75rem/1.4 var(--font-mono); color: var(--color-text-muted); }
  }

  /* v2: the plate is a light card inside the navy hero, so it resets to light tokens */
  .tooth {
    --color-text: var(--palette-ink-900);
    --color-text-muted: var(--palette-stone-600);
    --color-text-accent: var(--palette-sage-600);
    --color-accent: var(--palette-sage-500);
    --color-border: var(--palette-stone-200);
    --color-bg: var(--palette-stone-50);
    color: var(--color-text);
    border-radius: inherit;
    overflow: hidden;
  }
  /* Callouts get their own column: they can no longer sit on the tooth («02 Гигиена» overlap) */
  @media (min-width: 64rem) {
    .tooth { grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1fr); place-items: center; padding-bottom: 3rem; }
    .tooth__poster, .tooth__viewer { grid-area: 1 / 2; }
    .tooth__notes {
      position: static;
      grid-area: 1 / 1;
      display: grid;
      gap: var(--space-6);
      justify-self: start;
      padding-left: var(--space-5);
    }
    .tooth__notes li { position: relative; left: auto; top: auto; }
  }
</style>
