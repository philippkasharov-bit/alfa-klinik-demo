---
// Homepage hero. Copy is paraphrased strictly from the clinic's own stated
// benefits on alfaklinik.ru/skidki.htm — no invented claims or numbers.
import Button from '../ui/Button.astro';
import HeroTooth from './HeroTooth.astro';
import { clinic } from '../../data/clinic';
import { appointmentCta } from '../../data/navigation';

interface Props {
  /** Supply once real photography exists. Without it the 3D tooth renders. */
  image?: { src: string; alt: string; width: number; height: number };
}
const { image } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container container--wide hero__grid">
    <div class="hero__content">
      <div class="hero__main">
      <!-- No reveal on the headline/lead: they are the LCP candidates and must paint without waiting for JS -->
      <h1 id="hero-title" class="t-display hero__title">
        <span class="hero__w" style="--i: 0"><span>Внимательная</span></span> <span class="hero__w" style="--i: 1"><span>стоматология</span></span> <em><span class="hero__w" style="--i: 2"><span>и</span></span> <span class="hero__w" style="--i: 3"><span>понятное</span></span> <span class="hero__w" style="--i: 4"><span>лечение</span></span></em>
      </h1>

      <p class="t-body-lg hero__lead">
        Понятно объясняем план лечения, его стоимость, сроки и&nbsp;гарантии.
        Результаты консультации выдаём на&nbsp;руки&nbsp;— решение остаётся за&nbsp;вами.
      </p>

      <div class="btn-group hero__actions" data-reveal="slide" style="--reveal-delay: 3">
        <Button href={clinic.phone.href} arrow block="mobile" data-book>{appointmentCta.labelLong}</Button>
        <Button href="/skidki" variant="text">Действующие акции</Button>
      </div>
      </div>

      <dl class="hero__facts" data-reveal="fade" style="--reveal-delay: 4">
        <div>
          <dt class="t-label">Адрес</dt>
          <dd>{clinic.addressShort}</dd>
        </div>
        <div>
          <dt class="t-label">Телефон</dt>
          <dd><a class="hero__phone t-num" href={clinic.phone.href}>{clinic.phone.display}</a></dd>
        </div>
        <div>
          <dt class="t-label">Время работы</dt>
          <dd class="t-num">{clinic.hours[0].time}, вс — выходной</dd>
        </div>
      </dl>
    </div>

    <figure class="hero__media" data-reveal="image" style="--reveal-delay: 1">
      {image ? (
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <HeroTooth />
      )}
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-4) var(--section-sm);
    overflow-x: clip; /* full-bleed image must never cause horizontal scroll */
  }

  /* ---------- Mobile first: vertical ---------- */
  .hero__grid {
    display: grid;
    gap: var(--space-6);
  }

  /* Mobile: flatten so facts can sit below the image (text → CTA → image → facts) */
  .hero__content { display: contents; }
  .hero__main { order: 1; }
  .hero__media { order: 2; }
  .hero__facts { order: 3; }


  .hero__title {
    max-width: 17ch;   /* two-to-three confident lines on desktop, not a narrow column */
    font-size: clamp(2.625rem, 1.7rem + 4.6vw, 6rem); /* 42 @320 → 96 */
    hyphens: manual;
  }
  .hero__title em { display: block; }

  .hero__lead {
    max-width: 34ch;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .hero__actions { margin-top: var(--space-6); }

  .hero__facts {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .hero__facts div { display: grid; gap: var(--space-1); align-content: start; }
  .hero__facts div:last-child { grid-column: 1 / -1; }
  .hero__facts dd {
    margin: 0;
    font-size: var(--size-small);
    font-weight: var(--weight-medium);
  }
  .hero__phone {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    margin-block: -0.625rem;          /* keep the row's visual rhythm while enlarging the hit area */
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .hero__phone:hover { color: var(--color-text-accent); }

  /* Image: full-bleed on mobile — edge to edge, no card */
  .hero__media {
    position: relative;
    margin-inline: calc(var(--gutter) * -1); /* full-bleed; vw would include the scrollbar */
    aspect-ratio: 4 / 5;
    max-height: 70svh;
    overflow: hidden;
    background: var(--color-bg-subtle);
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  /* Very small phones (320px): keep the CTA above the fold */
  @media (max-width: 22.5rem) {
    .hero__lead { font-size: var(--size-body); line-height: var(--leading-normal); }
  }

  /* ---------- Small tablets ---------- */
  @media (min-width: 40rem) {
    .hero__facts { grid-template-columns: repeat(3, auto); justify-content: start; column-gap: var(--space-7); }
    .hero__facts div:last-child { grid-column: auto; }
    .hero__media { aspect-ratio: 5 / 4; }
  }

  /* ---------- Desktop: editorial split, image bleeds to the right edge ---------- */
  @media (min-width: 64rem) {
    .hero { padding-block: var(--space-5) var(--section-md); }

    /* Asymmetric split: tight text column (40) against a larger visual anchor (60) */
    .hero__grid {
      grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
      gap: var(--col-gap-tight); /* intentional: supports the hero asymmetry */
      align-items: start;
      min-height: min(calc(100svh - var(--header-height) - var(--space-5) - 1px), 56rem); /* 1px = header hairline */
    }

    .hero__content {
      display: grid;
      align-content: space-between;
      gap: var(--space-6);
      /* Vertical step: the image starts at the grid top, the text ~32px lower */
      padding-top: var(--space-6);
      align-self: stretch;
    }
    .hero__main, .hero__media, .hero__facts { order: 0; }
    /* Headline scales with viewport height too, so the whole hero fits above the fold */
    /* Sized so «и понятное лечение» always fits one line in the 45% column → 3 lines, not 4 */
    .hero__title { font-size: clamp(3.25rem, 0.4rem + 4.6vw, 4.75rem); }
    .hero__facts { grid-template-columns: repeat(3, auto); justify-content: space-between; column-gap: var(--space-5); }
    .hero__lead { max-width: 38ch; margin-top: calc(var(--space-6) + 0.75rem); }
    .hero__actions { margin-top: var(--space-7); }

    .hero__media {
      /* Partial bleed past the container's right edge — gutter + 32px */
      margin: 0 calc((var(--gutter) + var(--space-6)) * -1) 0 0;
      aspect-ratio: auto;
      max-height: none;
      min-height: 34rem;
      align-self: stretch;
      border-radius: var(--radius-sm) 0 0 var(--radius-sm);
      /* Layering: the panel crosses the section edge into the whitespace below */
      position: relative;
      z-index: 1;
      margin-bottom: calc(var(--space-8) * -2.5);
      box-shadow: var(--shadow-card);
    }
  }

  /* Beyond the wide container the bleed narrows but never squares off to the grid */
  @media (min-width: 102rem) {
    .hero__media { margin-right: calc(var(--space-8) * -1); }
  }

  /* ================= v2 (Baseline-derived): navy hero card ================= */
  .hero {
    /* Local token overrides: everything inside reads light-on-navy */
    --color-text: var(--color-text-inverse);
    --color-text-muted: rgb(255 255 255 / 0.74);   /* 7.2:1 on navy */
    --color-text-accent: #9DBDF2;                  /* 6.8:1 on navy */
    --color-border: var(--color-border-inverse);
    --color-accent: #FFFFFF;                       /* primary button: white plate, navy text */
    --color-accent-hover: #EAF1FB;
    --color-on-accent: var(--color-bg-inverse);
    --color-focus: #9DBDF2;
    margin: var(--space-2);
    padding-block: var(--space-6) var(--space-7);
    border-radius: var(--radius-md);
    background: var(--color-bg-inverse);
    color: var(--color-text);
    overflow: clip;
  }
  .hero__title {
    max-width: none;
    font-family: var(--font-sans);
    font-weight: var(--weight-medium);
    font-size: clamp(2.375rem, 0.4rem + 3.8vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  .hero__title em { display: inline; color: var(--color-text-accent); }
  /* Word-by-word clip-mask rise (template «TextEngine»): transform only, so the text
     still paints immediately for LCP; reduced motion shows it in place. */
  .hero__w { display: inline-block; overflow: clip; padding-bottom: 0.08em; vertical-align: top; }
  .hero__w > span { display: inline-block; animation: hero-word 1.1s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: calc(var(--i) * 110ms); }
  @keyframes hero-word { from { transform: translateY(105%); } }
  @media (prefers-reduced-motion: reduce) { .hero__w > span { animation: none; } }

  /* Facts become the template's glass card */
  .hero__facts {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border-inverse);
    border-top: 1px solid var(--color-border-inverse);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(12px);
  }
  .hero__facts dt { color: var(--color-text-muted); }
  .hero__facts dd { white-space: nowrap; }
  @media (min-width: 64rem) { .hero__facts { grid-template-columns: repeat(3, auto); justify-content: space-between; column-gap: var(--space-5); } }
  .hero__media { box-shadow: none; background: transparent; }
  @media (min-width: 64rem) {
    .hero { padding-block: var(--space-5); }
    /* The navy card fits the first viewport (template: 100svh minus the page inset) */
    .hero__grid { min-height: calc(100svh - var(--header-height) - var(--space-5) * 2 - var(--space-2) * 2 - 1px); }
    .hero__content { padding-top: var(--space-3); }
    .hero__media {
      margin: 0;
      border-radius: var(--radius-sm);
      min-height: 0;
    }
  }
</style>
