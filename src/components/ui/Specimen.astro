---
// "Specimen plate": a render of the hero's 3D molar, shown like a figure in a
// clinical atlas — soft lit plate, hairline annotations, small caption.
// Replaces photo placeholders without inventing photos of the clinic, people or
// interiors. Renders live in public/models/tooth-<view>.webp (720², ~21 KB each),
// generated from the same optimized GLB as the hero.
interface Props {
  view: 'profile' | 'low' | 'back' | 'front';
  /** Short caption under the plate, e.g. the service name */
  caption?: string;
  /** Up to 4 short annotation labels, set beside the tooth */
  notes?: string[];
  tone?: 'light' | 'dark';
  /** Extra attributes for the annotation list (used by scroll-linked sections) */
  notesAttrs?: Record<string, string>;
  class?: string;
}
const { view, caption, notes = [], tone = 'light', notesAttrs = {}, class: cls } = Astro.props;
---
<figure class:list={['specimen', `specimen--${tone}`, cls]}>
  <div class="specimen__stage">
    <img
      class="specimen__img"
      src={`/models/tooth-${view}.webp`}
      alt=""
      width="720"
      height="720"
      loading="lazy"
      decoding="async"
    />
    <ul class="specimen__notes" role="list" {...notesAttrs} hidden={notes.length === 0}>
      {notes.slice(0, 4).map((n) => <li>{n}</li>)}
    </ul>
  </div>
  {caption && <figcaption class="specimen__caption">{caption}</figcaption>}
</figure>

<style>
  .specimen {
    --plate-fg: var(--color-text);
    --plate-muted: var(--color-text-muted);
    --plate-rule: color-mix(in srgb, var(--color-accent) 45%, transparent);
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100%;
    margin: 0;
    --plate-grid: var(--color-border);
    background:
      linear-gradient(var(--plate-grid) 1px, transparent 1px) 0 0 / 100% 25%,
      linear-gradient(90deg, var(--plate-grid) 1px, transparent 1px) 0 0 / 25% 100%,
      var(--color-bg-subtle);
    color: var(--plate-fg);
    overflow: hidden;
  }
  .specimen--dark {
    --plate-fg: var(--color-text-inverse);
    --plate-muted: color-mix(in srgb, var(--color-text-inverse) 70%, transparent);
    --plate-rule: color-mix(in srgb, var(--color-text-inverse) 30%, transparent);
    --plate-grid: color-mix(in srgb, var(--color-text-inverse) 12%, transparent);
    background:
      linear-gradient(var(--plate-grid) 1px, transparent 1px) 0 0 / 100% 25%,
      linear-gradient(90deg, var(--plate-grid) 1px, transparent 1px) 0 0 / 25% 100%,
      color-mix(in srgb, var(--color-bg-inverse) 92%, var(--color-text-inverse));
  }

  .specimen__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    align-items: center;
    min-height: 0;
    padding: var(--space-5) var(--space-5) var(--space-3);
  }
  /* Height-led: the plate's container sets the size, the tooth never crops */
  .specimen__img {
    width: auto;
    height: 100%;
    max-width: 100%;
    max-height: 30rem;
    aspect-ratio: 1;
    object-fit: contain;
    justify-self: center;
  }

  /* Annotations: a hairline index set at the plate's right edge, each label
     with a short leader rule pointing back toward the specimen. */
  .specimen__notes {
    position: absolute;
    right: var(--space-5);
    top: 50%;
    translate: 0 -50%;
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: note;
    font: var(--weight-regular) 0.75rem/1.35 var(--font-mono);
    letter-spacing: 0.01em;
    color: var(--plate-fg);
  }
  .specimen__notes[hidden] { display: none; }
  .specimen__notes li {
    counter-increment: note;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .specimen__notes li::before {
    content: "";
    flex: none;
    width: clamp(1.5rem, 4vw, 3.5rem);
    height: 1px;
    background: var(--color-accent);
  }
  .specimen--dark .specimen__notes li::before { background: var(--plate-rule); }
  .specimen__notes li::after {
    content: counter(note, decimal-leading-zero);
    order: -1;
    color: var(--color-text-accent);
  }
  .specimen--dark .specimen__notes li::after { color: var(--plate-muted); }

  .specimen__caption {
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--plate-fg);
    background: var(--color-bg);
    font: var(--weight-regular) 0.75rem/1.3 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }
  .specimen--dark .specimen__caption { background: transparent; color: var(--plate-muted); }
  .specimen__caption::before { content: "Рис. — "; color: var(--color-text-accent); }
  .specimen--dark .specimen__caption::before { color: var(--plate-muted); }

  /* With notes the tooth shifts left so labels never sit on it */
  .specimen__stage:has(.specimen__notes:not([hidden])) .specimen__img {
    justify-self: start;
    max-width: 62%;
  }
  @media (max-width: 39.99rem) {
    .specimen__notes { right: var(--space-4); gap: var(--space-3); }
    .specimen__notes li::before { width: 1rem; }
  }
</style>
