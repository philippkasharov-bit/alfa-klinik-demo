---
interface Props {
  /** primary = solid sage pill · secondary = accent outline pill · tertiary = underlined text link */
  variant?: 'primary' | 'secondary' | 'tertiary' | 'text';
  size?: 'md' | 'sm';
  href?: string;
  type?: 'button' | 'submit';
  arrow?: boolean;
  block?: boolean | 'mobile';
  class?: string;
  [key: string]: unknown;
}
const { variant = 'primary', size = 'md', href, type = 'button', arrow = false, block = false, class: cls, ...rest } = Astro.props;
const classes = [
  'btn', `btn--${variant === 'tertiary' ? 'text' : variant}`,
  size === 'sm' && 'btn--sm',
  block === true && 'btn--block',
  block === 'mobile' && 'btn--block-mobile',
  cls,
];
const Tag = href ? 'a' : 'button';
---
<Tag class:list={classes} href={href} type={href ? undefined : type} {...rest}>
  <slot />
  {arrow && (
    <svg class="btn__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" />
    </svg>
  )}
</Tag>
