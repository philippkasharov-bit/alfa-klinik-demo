---
// Doctors: one large featured profile + a horizontal rail of supporting profiles.
// Uses real doctors from data/doctors.ts when present; otherwise one labelled
// placeholder per verified department.
import Section from '../layout/Section.astro';
import DoctorCard from './DoctorCard.astro';
import { doctors, doctorSlotOrder, doctorsSection, type DepartmentId, type Doctor } from '../../data/doctors';

type Slot = { department: DepartmentId; doctor?: Doctor };

const slots: Slot[] =
  doctors.length > 0
    ? [...doctors]
        .sort((a, b) => Number(!!b.featured) - Number(!!a.featured))
        .map((d) => ({ department: d.department, doctor: d }))
    : doctorSlotOrder.map((department) => ({ department }));

const [featured, ...others] = slots;
const hasPlaceholders = slots.some((s) => !s.doctor);
---
<Section width="wide" tone="subtle" labelledby="doctors-title" id="doctors" class="doctors">
  <header class="doctors__head">
    <div class="doctors__head-main">
      <p class="t-label" data-reveal="fade">{doctorsSection.eyebrow}</p>
      <h2 id="doctors-title" class="t-h2" data-reveal="slide">
        {doctorsSection.heading.lead}{' '}<em>{doctorsSection.heading.accent}</em>
      </h2>
    </div>
    <p class="t-body t-muted doctors__intro" data-reveal="fade" style="--reveal-delay: 1">{doctorsSection.intro}</p>
  </header>

  {hasPlaceholders && (
    <p class="doctors__notice" role="note">
      <span class="doctors__notice-label">Скоро</span>
      {doctorsSection.placeholderNotice}
    </p>
  )}

  <div class="doctors__featured" data-reveal="slide">
    <DoctorCard doctor={featured.doctor} department={featured.department} variant="featured" />
  </div>

  {others.length > 0 && (
    <div class="doctors__rail" data-doctor-rail>
      <div class="doctors__rail-head">
        <h3 class="t-h3 doctors__rail-title">Другие специалисты</h3>
        <div class="doctors__controls" data-rail-controls hidden>
          <button type="button" class="doctors__ctrl" data-rail-prev aria-label="Предыдущие врачи">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M15 8H2M7 3 2 8l5 5" stroke="currentColor" stroke-width="1.3"/></svg>
          </button>
          <button type="button" class="doctors__ctrl" data-rail-next aria-label="Следующие врачи">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.3"/></svg>
          </button>
        </div>
      </div>

      <ul class="doctors__list" role="list" tabindex="0" aria-label="Другие специалисты, прокрутка по горизонтали" data-rail-track>
        {others.map((s, i) => (
          <li data-reveal="slide" style={`--reveal-delay: ${i}`}>
            <DoctorCard doctor={s.doctor} department={s.department} variant="compact" headingLevel="h4" />
          </li>
        ))}
      </ul>
    </div>
  )}
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-doctor-rail]').forEach((rail) => {
    const track = rail.querySelector<HTMLElement>('[data-rail-track]')!;
    const controls = rail.querySelector<HTMLElement>('[data-rail-controls]')!;
    const prev = rail.querySelector<HTMLButtonElement>('[data-rail-prev]')!;
    const next = rail.querySelector<HTMLButtonElement>('[data-rail-next]')!;

    const step = () => {
      const item = track.querySelector<HTMLElement>('li');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return item ? item.offsetWidth + gap : track.clientWidth * 0.8;
    };
    const update = () => {
      const overflow = track.scrollWidth - track.clientWidth > 2;
      controls.hidden = !overflow;
      // Only a scrollable track needs to be a keyboard stop
      if (overflow) track.setAttribute('tabindex', '0');
      else track.removeAttribute('tabindex');
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    };

    const behavior = (): ScrollBehavior =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: behavior() }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: behavior() }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  });
</script>

<style>
  .doctors__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .doctors__head-main { display: grid; gap: var(--space-4); }
  .doctors__head .t-h2 em { display: inline; font-style: normal; } /* one continuous phrase — split-italic is reserved for hero / offer / final */
  .doctors__intro { max-width: 40ch; }

  @media (min-width: 64rem) {
    .doctors__head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--col-gap);
      align-items: start;
      margin-bottom: var(--space-7);
    }
    .doctors__intro { padding-top: var(--space-6); }
  }

  .doctors__notice {
    display: grid;
    gap: var(--space-1);
    max-width: 62ch;
    margin-bottom: var(--space-8);
    padding: var(--space-4) var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--size-small);
    color: var(--color-text-muted);
  }
  .doctors__notice-label {
    font-size: var(--size-label);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.01em;
    color: var(--color-text);
  }

  /* ---------- Rail ---------- */
  .doctors__rail { margin-top: var(--space-9); }
  @media (max-width: 39.99rem) {
    .doctors__notice { margin-bottom: var(--space-6); padding: var(--space-3) var(--space-4); }
    .doctors__rail { margin-top: var(--space-7); }
  }

  .doctors__rail-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-text);
  }
  .doctors__rail-title { margin: 0; }

  .doctors__controls { display: flex; gap: var(--space-2); }
  .doctors__controls[hidden] { display: none; }
  .doctors__ctrl {
    display: grid;
    place-items: center;
    width: var(--touch-target);
    height: var(--touch-target);
    background: none;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard),
                border-color var(--duration-fast) var(--ease-standard),
                opacity var(--duration-fast) var(--ease-standard);
  }
  .doctors__ctrl:hover:not(:disabled) { background: var(--color-text); border-color: var(--color-text); color: var(--color-bg); }
  .doctors__ctrl:disabled { opacity: 0.35; cursor: default; }
  .doctors__ctrl:focus-visible { border-radius: 50%; }

  /* Horizontal scroll-snap track. Bleeds to the screen edge so cards peek. */
  .doctors__list {
    display: grid;
    grid-auto-flow: column;
    /* Viewport-based widths: % doesn't resolve inside a scrolling grid track */
    --rail-inner: min(calc(100vw - 2 * var(--gutter)), var(--container-wide));
    grid-auto-columns: calc(var(--rail-inner) * 0.78);
    gap: var(--grid-gap);
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter) var(--space-3);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong) transparent;
  }
  .doctors__list > li { scroll-snap-align: start; }
  .doctors__list:focus-visible { outline-offset: 4px; }

  @media (min-width: 40rem) {
    .doctors__list { grid-auto-columns: calc((var(--rail-inner) - var(--grid-gap)) / 2.2); }
  }
  @media (min-width: 64rem) {
    .doctors__list { grid-auto-columns: calc((var(--rail-inner) - 3 * var(--grid-gap)) / 3.4); }
  }
  /* Wide screens: no scrolling — a calm static row (wraps to more rows if the clinic
     adds more doctors). The script hides the arrows because nothing overflows. */
  @media (min-width: 80rem) {
    .doctors__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
      row-gap: var(--space-8);
      margin: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
  }
</style>
