---
import Section from '../layout/Section.astro';
import ServiceItem from './ServiceItem.astro';
import { services } from '../../data/services';
---
<Section width="wide" tone="subtle" labelledby="services-title" id="services" class="services">
  <header class="services__head">
    <p class="t-label" data-reveal="fade">Услуги</p>
    <h2 id="services-title" class="t-h2" data-reveal="slide">
      Семь направлений, <em>одна клиника</em>
    </h2>
    <p class="t-body t-muted services__intro" data-reveal="slide" style="--reveal-delay: 1">
      Шесть отделений и профессиональная гигиена — от диагностики
      до протезирования и ортодонтии.
    </p>
  </header>

  <ol class="services__list" role="list" data-services>
    {services.map((service, i) => <ServiceItem service={service} index={i} />)}
  </ol>
</Section>

<script>
  const DESKTOP = window.matchMedia('(min-width: 64rem)');

  document.querySelectorAll<HTMLElement>('[data-services]').forEach((list) => {
    const items = [...list.querySelectorAll<HTMLElement>('[data-service]')];
    const triggers = items.map((li) => li.querySelector<HTMLButtonElement>('[data-service-trigger]')!);
    let active = -1;

    const set = (index: number) => {
      active = index;
      items.forEach((li, i) => {
        const on = i === index;
        li.classList.toggle('is-active', on);
        triggers[i].setAttribute('aria-expanded', String(on));
      });
    };

    // Desktop: hover or focus previews, one panel is always open.
    // Mobile: tap toggles, single-open accordion, all closed initially.
    triggers.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        if (DESKTOP.matches) set(i);
        else set(active === i ? -1 : i);
      });
      btn.addEventListener('pointerenter', (e) => {
        if (DESKTOP.matches && e.pointerType === 'mouse') set(i);
      });
      btn.addEventListener('focus', () => { if (DESKTOP.matches) set(i); });
    });

    // Desktop panels are absolutely positioned; reserve height for the tallest one
    // so no panel can spill into the next section.
    const fitHeight = () => {
      list.style.minHeight = '';
      if (!DESKTOP.matches) return;
      const tallest = Math.max(
        ...items.map((li) => li.querySelector<HTMLElement>('.service__panel-inner')!.scrollHeight),
      );
      if (tallest > list.offsetHeight) list.style.minHeight = `${tallest}px`;
    };

    // Deep links (/#service-implantology, e.g. from the mobile menu) open that service.
    const openFromHash = () => {
      const idx = items.findIndex((li) => `#${li.id}` === location.hash);
      if (idx < 0) return false;
      set(idx);
      fitHeight();
      // Wait for the accordion height change to settle, otherwise the target moves after we scroll.
      const settle = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 340;
      setTimeout(() => items[idx].scrollIntoView({ block: 'start' }), settle);
      return true;
    };

    const init = () => {
      if (openFromHash()) return;
      set(DESKTOP.matches ? Math.max(active, 0) : -1);
      fitHeight();
    };
    window.addEventListener('hashchange', openFromHash);
    list.classList.add('is-enhanced');
    init();
    DESKTOP.addEventListener('change', init);
    window.addEventListener('resize', fitHeight, { passive: true });
    document.fonts?.ready.then(fitHeight);
  });
</script>

<style>
  .services__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  .services__head .t-h2 em { display: inline; font-style: normal; } /* one continuous phrase — split-italic is reserved for hero / offer / final */
  /* Chapter-opening headline: same enlarged scale as the hero and technology */
  .services__head .t-h2 {
    font-size: var(--size-title);
    line-height: 1.06;
    letter-spacing: -0.015em;
  }
  .services__intro { max-width: 44ch; }

  @media (min-width: 64rem) {
    .services__head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--col-gap);
      align-items: end;
      margin-bottom: var(--space-9);
    }
    .services__head .t-label { grid-column: 1; }
    .services__head .t-h2 { grid-column: 1; }
    .services__intro { grid-column: 2; grid-row: 2; padding-bottom: 0.4em; }
  }

  .services__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-text);
  }
</style>

<style is:global>
  /* Global (not scoped) because the rules span ServiceItem's markup and JS state.
     Collapsed/side-panel rules apply as soon as <html> has .js-motion (set inline in <head>),
     so the layout is final at first paint — no shift when the script enhances the list.
     Without JS (or if the failsafe removes .js-motion) everything is simply expanded. */

  /* ================= Row ================= */
  .service { border-bottom: 1px solid var(--color-border); }
  .service__heading { margin: 0; font: inherit; }

  .service__trigger {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    min-height: 4.5rem;
    padding: var(--space-4) 0;
    background: none;
    border: 0;
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
  }
  .service__trigger:focus-visible { outline-offset: -2px; }

  .service__num {
    align-self: start;
    padding-top: 0.55rem;
    font-size: var(--size-label);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }
  .service__titles {
    display: grid;
    gap: 0.15rem;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .service__name {
    font-family: var(--font-display);
    font-size: var(--size-row);
    font-weight: var(--weight-medium);
    line-height: 1.1;
    letter-spacing: -0.01em;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .service__summary {
    font-size: var(--size-small);
    color: var(--color-text-muted);
  }

  .service__icon {
    display: grid;
    place-items: center;
    width: var(--touch-target);
    height: var(--touch-target);
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    transition:
      transform var(--duration-base) var(--ease-out),
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }
  /* Mobile: arrow points down, rotates up when open */
  .service__icon svg { transform: rotate(90deg); transition: transform var(--duration-base) var(--ease-out); }
  .service.is-active .service__icon svg { transform: rotate(-90deg); }
  .service.is-active .service__icon { background: var(--color-text); border-color: var(--color-text); color: var(--color-bg); }

  /* ================= Panel ================= */
  .service__panel-inner {
    display: grid;
    gap: var(--space-5);
    padding: 0 0 var(--space-6) calc(2rem + var(--space-4));
  }

  /* Visual: hidden on mobile to keep rows scannable */
  .service__visual { display: none; }

  .service__description { max-width: 46ch; line-height: var(--leading-normal); }

  .service__includes {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
    font-size: var(--size-small);
  }
  .service__includes li {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  /* Sentence-length badge: keeps the 2:1 ratio by widening, not by squeezing the line */
  .service__offer { justify-self: start; min-height: auto; padding-block: var(--space-2); padding-inline: 1rem; line-height: 1.4; text-transform: none; letter-spacing: 0.01em; font-size: var(--size-small); font-weight: var(--weight-medium); }
  .service__link { justify-self: start; }
  .service__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); }
  /* Narrow phones: tel: link dials directly, the number itself isn't needed in the button */
  @media (max-width: 29.99rem) { .service__actions .btn--secondary .t-num, .service__actions .btn--secondary .service__sep { display: none; } }
  .service { scroll-margin-top: calc(var(--header-height) + var(--space-4)); }

  /* Collapse behaviour only once JS has enhanced the list */
  :is(.is-enhanced, .js-motion .services__list) .service__panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows var(--duration-base) var(--ease-out),
      visibility 0s linear var(--duration-base);
  }
  :is(.is-enhanced, .js-motion .services__list) .service__panel > .service__panel-inner { overflow: hidden; min-height: 0; }
  :is(.is-enhanced, .js-motion .services__list) .service.is-active .service__panel {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows var(--duration-base) var(--ease-out), visibility 0s;
  }

  /* ================= Desktop: list + side panel ================= */
  @media (min-width: 64rem) {
    .services__list:is(.is-enhanced, .js-motion *) {
      position: relative;
      width: 42%;
      min-height: 46rem;
    }

    .service__trigger {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
      min-height: 5.5rem;
    }
    .service__icon { border-color: transparent; }
    .service__icon svg { transform: none; }
    .service.is-active .service__icon svg { transform: none; }
    .service.is-active .service__icon { background: none; border-color: transparent; color: var(--color-text-accent); }

    /* Quiet the rest of the list while one row is in focus */
    :is(.is-enhanced, .js-motion .services__list) .service:not(.is-active) .service__name { color: color-mix(in srgb, var(--color-text) 58%, var(--color-bg-subtle)); }
    :is(.is-enhanced, .js-motion .services__list) .service:not(.is-active) .service__summary { opacity: 0; }
    .service__summary { transition: opacity var(--duration-base) var(--ease-standard); }
    :is(.is-enhanced, .js-motion .services__list) .service:not(.is-active) .service__trigger:hover .service__name { color: var(--color-text); }

    .service.is-active .service__titles { transform: translateX(0.5rem); }
    .service__trigger:hover .service__icon { transform: translateX(0.25rem); }
    .service.is-active .service__icon { transform: translateX(0.25rem); }

    /* Panel sits to the right of the list: 42% list + 8% gap + 50% panel
       (percentages are relative to the list, hence the /42 maths) */
    :is(.is-enhanced, .js-motion .services__list) .service__panel {
      position: absolute;
      top: 0;
      left: calc(100% / 42 * 50);
      width: calc(100% / 42 * 50);
      display: block;
      opacity: 0;
      transform: translateY(0.5rem);
      transition:
        opacity var(--duration-base) var(--ease-standard),
        transform var(--duration-slow) var(--ease-out),
        visibility 0s linear var(--duration-base);
    }
    :is(.is-enhanced, .js-motion .services__list) .service.is-active .service__panel {
      opacity: 1;
      transform: none;
      transition:
        opacity var(--duration-slow) var(--ease-standard) 60ms,
        transform var(--duration-slow) var(--ease-out) 60ms,
        visibility 0s;
    }
    :is(.is-enhanced, .js-motion .services__list) .service__panel > .service__panel-inner { overflow: visible; }
    /* Before the script picks the active row, show the first panel (matches its initial state) */
    .js-motion .services__list:not(.is-enhanced) .service:first-child .service__panel {
      opacity: 1;
      transform: none;
      visibility: visible;
    }

    .service__panel-inner {
      gap: var(--space-6);
      padding: 0;
    }

    .service__visual {
      position: relative;
      display: flex;
      align-items: flex-end;
      aspect-ratio: 2 / 1;
      padding: var(--space-5);
      overflow: hidden;
      border-radius: var(--radius-sm);
      background: linear-gradient(160deg, var(--color-bg-accent), var(--color-bg));
      border: 1px dashed var(--color-border-strong);
    }
    .service__visual-num {
      position: absolute;
      top: -0.12em;
      right: var(--space-5);
      font-family: var(--font-display);
      font-size: clamp(8rem, 4rem + 8vw, 13rem);
      line-height: 1;
      font-style: italic;
      color: color-mix(in srgb, var(--color-accent) 22%, transparent);
      transform: translateY(0.75rem) scale(1.04);
      transition: transform var(--duration-reveal) var(--ease-out);
    }
    .service.is-active .service__visual-num { transform: none; }

    .service__body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-5) var(--space-6);
      align-items: start;
    }
    .service__description {
      grid-column: 1 / -1;
      font-size: var(--size-body-lg);
      line-height: var(--leading-relaxed);
    }
    .service__includes { grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); }
    .service__offer, .service__link { grid-column: 1 / -1; }
  }

  /* Without JS on desktop, keep a readable stacked layout */
  @media (min-width: 64rem) {
    .services__list:not(.is-enhanced):not(.js-motion *) .service__panel-inner { padding: 0 0 var(--space-7) 2.5rem; }
  }

  /* Compact desktop: give names more room so rows stay even */
  @media (min-width: 64rem) and (max-width: 79.99rem) {
    .services__list:is(.is-enhanced, .js-motion *) { width: 46%; }
    :is(.is-enhanced, .js-motion .services__list) .service__panel {
      left: calc(100% / 46 * 52);
      width: calc(100% / 46 * 48);
    }
    .service__name { font-size: var(--size-row); }
  }
</style>
