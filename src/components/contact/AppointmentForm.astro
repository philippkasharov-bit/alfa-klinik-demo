---
// Callback request form — name, phone, optional message, consent.
// NO BACKEND: this pitch demo validates and shows a clearly-labelled demo result.
// Wire `action` to the clinic's CRM/email endpoint and remove `data-demo` in production.
// Copy never promises an appointment: the clinic calls back to agree a time.
import Field from '../ui/Field.astro';
import Button from '../ui/Button.astro';
import { clinic } from '../../data/clinic';

interface Props { id?: string; }
const { id = 'appointment' } = Astro.props;
---
<form class="appt" id={`${id}-form`} method="post" action="#" novalidate data-appt-form data-demo>
  <p class="appt__title" id={`${id}-form-title`}>Оставьте номер — мы перезвоним</p>
  <p class="appt__lead">
    Администратор свяжется с вами, чтобы подобрать удобное время. Запись считается подтверждённой после звонка.
  </p>

  <p class="appt__required"><span aria-hidden="true">*</span> — обязательные поля</p>

  <div class="appt__fields">
    <Field id={`${id}-name`} label="Как к вам обращаться" autocomplete="name" required />
    <Field
      id={`${id}-phone`}
      type="tel"
      label="Телефон"
      autocomplete="tel"
      placeholder="+7 (___) ___-__-__"
      hint="Только для обратного звонка"
      required
    />
    <Field id={`${id}-message`} type="textarea" label="Комментарий (необязательно)" placeholder="Например, удобное время для звонка" />
  </div>

  <label class="check appt__consent">
    <input type="checkbox" name="consent" required aria-describedby={`${id}-consent-error`} data-appt-consent />
    <span>Согласен на обработку персональных данных для обратного звонка</span>
  </label>
  <p class="field__error appt__consent-error" id={`${id}-consent-error`} data-consent-error hidden>Нужно согласие, чтобы мы могли перезвонить.</p>

  <div class="appt__actions">
    <Button type="submit" block="mobile" arrow>Жду звонка</Button>
    <p class="appt__alt">или позвоните: <a class="link t-num" href={clinic.phone.href}>{clinic.phone.display}</a></p>
  </div>

  <div class="appt__status" role="status" aria-live="polite" tabindex="-1" data-appt-status hidden></div>

  <p class="appt__demo-note">Демонстрационная форма: в макете не подключена к системе клиники.</p>
</form>

<script>
  const RU_PHONE_DIGITS = /^(?:7|8)?\d{10}$/;

  document.querySelectorAll<HTMLFormElement>('[data-appt-form]').forEach((form) => {
    const name = form.querySelector<HTMLInputElement>('input[autocomplete="name"]')!;
    const phone = form.querySelector<HTMLInputElement>('input[type="tel"]')!;
    const consent = form.querySelector<HTMLInputElement>('[data-appt-consent]')!;
    const consentError = form.querySelector<HTMLElement>('[data-consent-error]')!;
    const status = form.querySelector<HTMLElement>('[data-appt-status]')!;

    // Field.astro renders the error <p> only when an error prop is passed,
    // so we manage a runtime error element next to each input.
    const setError = (input: HTMLInputElement, message: string) => {
      const errId = `${input.id}-runtime-error`;
      let el = document.getElementById(errId);
      if (message) {
        if (!el) {
          el = document.createElement('p');
          el.id = errId;
          el.className = 'field__error';
          input.closest('.field')!.append(el);
        }
        el.textContent = message;
        input.setAttribute('aria-invalid', 'true');
        const described = new Set((input.getAttribute('aria-describedby') ?? '').split(' ').filter(Boolean));
        described.add(errId);
        input.setAttribute('aria-describedby', [...described].join(' '));
      } else {
        el?.remove();
        input.removeAttribute('aria-invalid');
        const described = (input.getAttribute('aria-describedby') ?? '').split(' ').filter((x) => x && x !== errId);
        if (described.length) input.setAttribute('aria-describedby', described.join(' '));
        else input.removeAttribute('aria-describedby');
      }
    };

    const validateName = () => {
      const ok = name.value.trim().length >= 2;
      setError(name, ok ? '' : 'Укажите имя — хотя бы две буквы.');
      return ok;
    };
    const validatePhone = () => {
      const digits = phone.value.replace(/\D/g, '');
      const ok = RU_PHONE_DIGITS.test(digits);
      setError(phone, ok ? '' : 'Проверьте номер: нужно 10 цифр после +7.');
      return ok;
    };
    const validateConsent = () => {
      consentError.hidden = consent.checked;
      consent.setAttribute('aria-invalid', String(!consent.checked));
      return consent.checked;
    };

    // Validate on blur (not while typing); clear errors as soon as input becomes valid.
    name.addEventListener('blur', validateName);
    phone.addEventListener('blur', validatePhone);
    name.addEventListener('input', () => name.getAttribute('aria-invalid') && validateName());
    phone.addEventListener('input', () => phone.getAttribute('aria-invalid') && validatePhone());
    consent.addEventListener('change', validateConsent);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const results = [validateName(), validatePhone(), validateConsent()];
      if (results.includes(false)) {
        const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
        firstInvalid?.focus();
        return;
      }

      status.hidden = false;
      status.className = 'appt__status is-success';
      status.textContent = form.hasAttribute('data-demo')
        ? 'Демо: данные проверены, но никуда не отправлены. В рабочей версии здесь появится подтверждение, что заявка принята и администратор перезвонит для записи.'
        : 'Заявка принята. Администратор перезвонит, чтобы подобрать время приёма.';
      status.focus?.();
    });
  });
</script>

<style>

  .appt {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-card);
  }
  .appt__title {
    font-family: var(--font-display);
    font-size: var(--size-title-sm);
    font-weight: var(--weight-medium);
    line-height: 1.15;
  }
  .appt__lead { margin-top: calc(var(--space-3) * -1); font-size: var(--size-small); color: var(--color-text-muted); max-width: 48ch; }

  .appt__required { margin-top: calc(var(--space-3) * -1); font-size: var(--size-label); color: var(--color-text-muted); }
  .appt__fields { display: grid; gap: var(--space-4); }
  @media (min-width: 40rem) {
    .appt__fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .appt__fields > :last-child { grid-column: 1 / -1; }
  }
  .appt :global(.textarea) { min-height: 6rem; }

  .appt__consent { margin-top: calc(var(--space-2) * -1); }
  .appt__consent-error { margin-top: calc(var(--space-4) * -1); }

  .appt__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }
  .appt__alt { font-size: var(--size-small); color: var(--color-text-muted); }

  .appt__status {
    padding: var(--space-4);
    border-left: 2px solid var(--color-accent);
    background: var(--color-accent-soft);
    font-size: var(--size-small);
    line-height: var(--leading-normal);
  }

  .appt__demo-note {
    font-size: var(--size-label);
    color: var(--color-text-muted);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-border-strong);
  }
</style>
