---
// Contact / appointment.
//   Desktop: LEFT heading + message + call CTA + callback form
//            RIGHT contact facts + directions + map
//   Mobile:  heading → call CTA → essentials (phone, hours, address) → form → directions → map
// All facts from data/clinic.ts (footer + contacts.htm).
import Section from '../layout/Section.astro';
import Button from '../ui/Button.astro';
import AppointmentForm from './AppointmentForm.astro';
import { clinic } from '../../data/clinic';

interface Props {
  id?: string;
  headingLevel?: 'h1' | 'h2';
}
const { id = 'contact', headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
const { lat, lon } = clinic.geo;
const yandexLink = `https://yandex.ru/maps/?pt=${lon},${lat}&z=17&l=map`;
const yandexWidget = `https://yandex.ru/map-widget/v1/?ll=${lon}%2C${lat}&z=16&pt=${lon}%2C${lat}%2Cpm2gnm`;
---
<Section width="wide" tone="subtle" labelledby={`${id}-title`} id={id} class="contact">
  <div class="contact__grid">
    <!-- ===== LEFT ===== -->
    <div class="contact__left">
      <header class="contact__head">
        <p class="t-label" data-reveal="fade">Запись на приём</p>
        <H id={`${id}-title`} class="contact__title" data-reveal="slide">
          Приходите <em>на консультацию</em>
        </H>
        <p class="contact__message" data-reveal="slide" style="--reveal-delay: 1">
          Позвоните — администратор подберёт удобное время и ответит на вопросы о лечении и стоимости.
        </p>
        <div class="contact__cta" data-reveal="slide" style="--reveal-delay: 2">
          <Button href={clinic.phone.href} arrow block="mobile">Позвонить {clinic.phone.display}</Button>
        </div>
      </header>

      <div class="contact__form" data-reveal="fade">
        <AppointmentForm id={`${id}-appt`} />
      </div>
    </div>

    <!-- ===== RIGHT ===== -->
    <div class="contact__right">
      <dl class="contact__facts" data-reveal="fade">
        <div class="contact__fact contact__fact--phone">
          <dt>Телефон</dt>
          <dd><a class="contact__phone t-num" href={clinic.phone.href}>{clinic.phone.display}</a></dd>
        </div>
        <div class="contact__fact">
          <dt>Время работы</dt>
          <dd>
            <span class="contact__hours t-num">{clinic.hours[0].time}</span>
            <span class="contact__muted">{clinic.hours[1].days}: {clinic.hours[1].time}</span>
          </dd>
        </div>
        <div class="contact__fact">
          <dt>Адрес</dt>
          <dd>
            <address>{clinic.address}</address>
            <span class="contact__muted">{clinic.entrance}</span>
          </dd>
        </div>
        <div class="contact__fact">
          <dt>E-mail</dt>
          <dd><a class="link" href={`mailto:${clinic.email}`}>{clinic.email}</a></dd>
        </div>
      </dl>

      <div class="contact__directions" data-reveal="fade">
        <p class="t-label">Как добраться</p>
        <p class="contact__notice">{clinic.directionsNotice}</p>
        <div class="contact__routes">
          {clinic.directions.map((d) => (
            <details class="contact__route" name={`${id}-routes`}>
              <summary>
                <span class="contact__metro" aria-hidden="true">М</span>
                <span class="contact__route-text">
                  <span class="contact__station">{d.station}</span>
                  <span class="contact__muted">{d.summary}</span>
                </span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </summary>
              <p class="contact__route-body">{d.text}</p>
            </details>
          ))}
        </div>
        <p class="contact__landmark">{clinic.landmark}</p>
      </div>

      <!-- Map: click-to-load (no third-party requests until the visitor asks) -->
      <div class="contact__map" data-map data-src={yandexWidget}>
        <div class="contact__map-placeholder" data-map-placeholder>
          <span class="contact__map-grid" aria-hidden="true"></span>
          <span class="contact__map-pin" aria-hidden="true"></span>
          <div class="contact__map-actions">
            <button type="button" class="btn btn--secondary btn--sm contact__map-btn" data-map-load>
              Показать карту
            </button>
            <a class="btn btn--text contact__map-link" href={yandexLink} target="_blank" rel="noopener">
              Открыть в Яндекс Картах<span class="visually-hidden"> (в новой вкладке)</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const btn = map.querySelector<HTMLButtonElement>('[data-map-load]');
    btn?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = map.dataset.src!;
      iframe.title = 'Карта: Альфа-Клиник, Москва, Воронцовские пруды, д. 3';
      iframe.loading = 'lazy';
      iframe.allowFullscreen = true;
      iframe.className = 'contact__map-frame';
      map.append(iframe);
      map.querySelector('[data-map-placeholder]')?.remove();
      iframe.focus();
    });
  });
</script>

<style>
  /* ---------- Grid & mobile order ---------- */
  .contact__grid { display: grid; gap: var(--space-7); }
  /* Mobile: flatten both columns so we can interleave in the most useful order */
  .contact__left, .contact__right { display: contents; }
  .contact__head { order: 1; }
  .contact__facts { order: 2; }
  .contact__form { order: 3; }
  .contact__directions { order: 4; }
  .contact__map { order: 5; }

  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--col-gap);
      align-items: start;
    }
    .contact__left, .contact__right { display: grid; gap: var(--space-8); align-content: start; }
    .contact__head, .contact__facts, .contact__form, .contact__directions, .contact__map { order: 0; }
    .contact__right { gap: var(--space-7); padding-top: var(--space-3); }
  }

  /* ---------- Heading ---------- */
  .contact__head { display: grid; gap: var(--space-4); }
  .contact__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: clamp(2.5rem, 1.6rem + 4vw, 5rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .contact__title em { display: inline; font-style: normal; } /* one continuous phrase — split-italic is reserved for hero / offer / final */
  .contact__message { max-width: 40ch; font-size: var(--size-body-lg); line-height: var(--leading-relaxed); color: var(--color-text-muted); }
  .contact__cta { margin-top: var(--space-2); }
  .contact__cta :global(.btn) { white-space: normal; text-align: center; line-height: 1.25; padding-block: var(--space-3); }

  /* ---------- Form card: the one raised surface in the section ---------- */
  .contact__form {
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }

  /* ---------- Facts ---------- */
  .contact__facts { display: grid; margin: 0; border-top: 1px solid var(--color-text); }
  .contact__fact {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .contact__fact dt {
    padding-top: 0.2rem;
    font-size: var(--size-label);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.01em;
    color: var(--color-text-muted);
  }
  .contact__fact dd { margin: 0; display: grid; gap: 0.15rem; overflow-wrap: anywhere; }
  .contact__fact dd > .link { display: inline-flex; align-items: center; min-height: var(--touch-target); justify-self: start; }
  .contact__fact { align-items: center; }
  .contact__fact address { font-style: normal; font-weight: var(--weight-medium); }
  .contact__phone {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-family: var(--font-display);
    font-size: var(--size-title-sm);
    line-height: 1.1;
  }
  .contact__phone:hover { color: var(--color-text-accent); }
  .contact__hours { font-weight: var(--weight-medium); }
  .contact__muted { font-size: var(--size-small); color: var(--color-text-muted); }

  @media (max-width: 23.99rem) {
    .contact__fact { grid-template-columns: 1fr; gap: var(--space-1); }
  }

  /* ---------- Directions ---------- */
  .contact__directions { display: grid; gap: var(--space-3); }
  .contact__notice {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--color-accent);
    background: var(--color-bg);
    font-size: var(--size-small);
  }
  .contact__routes { border-top: 1px solid var(--color-border); }
  .contact__route { border-bottom: 1px solid var(--color-border); interpolate-size: allow-keywords; }
  .contact__route summary {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) 1rem;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--touch-target);
    padding-block: var(--space-3);
    cursor: pointer;
    list-style: none;
  }
  .contact__route summary::-webkit-details-marker { display: none; }
  .contact__route[open] .accordion__icon::after { transform: rotate(0deg); }
  .contact__metro {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    font-size: var(--size-label);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
  }
  .contact__route-text { display: grid; gap: 0.1rem; }
  .contact__station { font-weight: var(--weight-medium); }
  .contact__route::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size var(--duration-base) var(--ease-out), content-visibility var(--duration-base) allow-discrete;
  }
  .contact__route[open]::details-content { block-size: auto; }
  .contact__route-body {
    padding: 0 0 var(--space-4) calc(1.75rem + var(--space-3));
    font-size: var(--size-small);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }
  .contact__landmark { font-size: var(--size-small); color: var(--color-text-muted); }

  @media (max-width: 63.99rem) {
    .contact__map { aspect-ratio: 16 / 10; }
    .contact__grid { gap: var(--space-6); }
    .contact__fact { padding-block: var(--space-2); }
    .contact__title { font-size: clamp(2.25rem, 1.5rem + 3.5vw, 3rem); }
    .contact__message { font-size: var(--size-body); }
  }

  /* ---------- Map ---------- */
  .contact__map {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-bg-accent);
  }
  .contact__map :global(.contact__map-frame) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .contact__map-placeholder { position: absolute; inset: 0; display: grid; place-items: end start; padding: var(--space-5); }
  .contact__map-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--color-accent) 18%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-accent) 18%, transparent) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    mask-image: radial-gradient(circle at 55% 45%, #000 20%, transparent 75%);
  }
  .contact__map-pin {
    position: absolute;
    left: 55%;
    top: 45%;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-accent) 25%, transparent), 0 0 0 14px color-mix(in srgb, var(--color-accent) 12%, transparent);
    translate: -50% -50%;
  }
  .contact__map-actions { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
  .contact__map-btn { background: var(--color-bg); }
</style>
