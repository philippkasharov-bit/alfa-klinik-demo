---
// Typographic wordmark. The original logo is a low-res raster (top-logo.jpg);
// replace with a vector mark once the client supplies one.
import { clinic } from '../../data/clinic';

interface Props {
  descriptor?: boolean;
  class?: string;
}
const { descriptor = true, class: cls } = Astro.props;
---
<a href="/" class:list={['logo', cls]} aria-label={`${clinic.name} — на главную`}>
  <span class="logo__mark" aria-hidden="true">α</span>
  <span class="logo__text">
    <span class="logo__name">{clinic.name}</span>
    {descriptor && <span class="logo__descriptor">{clinic.city} · {clinic.addressShort}</span>}
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--touch-target);
    color: var(--color-text);
  }
  .logo__mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-style: italic;
    line-height: 1;
    padding-bottom: 0.15rem;
    color: var(--color-text-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }
  .logo:hover .logo__mark { border-color: var(--color-accent); }
  .logo__text { display: grid; gap: 0.2rem; }
  .logo__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .logo__descriptor {
    font-size: var(--size-label);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1.2;
  }
</style>
