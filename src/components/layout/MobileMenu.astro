---
// Full-screen mobile navigation built on native <dialog>:
// focus trap, Esc to close, inert background and top-layer stacking come free.
import Logo from './Logo.astro';
import Button from '../ui/Button.astro';
import { clinic } from '../../data/clinic';
import { primaryNav, dentalServices, appointmentCta, isCurrent } from '../../data/navigation';

interface Props { id: string; }
const { id } = Astro.props;
const path = Astro.url.pathname;
---
<dialog id={id} class="mobile-menu" aria-label="Меню" data-mobile-menu>
  <div class="mobile-menu__bar container">
    <Logo descriptor={false} />
    <button class="mobile-menu__close" type="button" data-menu-close autofocus>
      <span>Закрыть</span>
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
        <path d="m2 2 12 12M14 2 2 14" stroke="currentColor" stroke-width="1.3" />
      </svg>
    </button>
  </div>

  <div class="mobile-menu__body container">
    <nav aria-label="Меню: основные разделы">
      <ol class="mobile-menu__primary" role="list">
        {primaryNav.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a href={item.href} aria-current={isCurrent(path, item.href) ? 'page' : undefined}>
              <span class="mobile-menu__index t-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <details class="mobile-menu__services" style={`--i: ${primaryNav.length}`}>
      <summary>
        <span class="t-label">Услуги стоматологии</span>
        <span class="accordion__icon" aria-hidden="true"></span>
      </summary>
      <ul role="list">
        {dentalServices.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </details>

    <div class="mobile-menu__contact" style={`--i: ${primaryNav.length + 1}`}>
      <a class="mobile-menu__phone t-num" href={clinic.phone.href}>{clinic.phone.display}</a>
      <p class="t-small t-num">{clinic.hours[0].time} · воскресенье — выходной</p>
      <p class="t-small t-muted">{clinic.address}</p>
      <a class="link t-small" href={`mailto:${clinic.email}`}>{clinic.email}</a>
    </div>
  </div>

  <div class="mobile-menu__footer container">
    <Button href={clinic.phone.href} block arrow>{appointmentCta.labelLong}</Button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  const desktop = window.matchMedia('(min-width: 64rem)');

  if (dialog) {
    const setExpanded = (v: boolean) =>
      openers.forEach((b) => b.setAttribute('aria-expanded', String(v)));

    const open = () => {
      dialog.showModal();
      document.documentElement.classList.add('menu-open');
      setExpanded(true);
    };
    // Idempotent: runs from our own close() and from the native 'close' event (Esc).
    const cleanup = () => {
      if (!document.documentElement.classList.contains('menu-open')) return;
      document.documentElement.classList.remove('menu-open');
      setExpanded(false);
      openers[0]?.focus();
    };
    const close = () => {
      dialog.close();
      cleanup();
    };

    openers.forEach((b) => b.addEventListener('click', open));
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', close);
    dialog.addEventListener('close', cleanup);

    // Close on navigation (incl. same-page anchors) and when resizing to desktop.
    dialog.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });
    desktop.addEventListener('change', (e) => { if (e.matches && dialog.open) close(); });
  }
</script>

<style is:global>
  html.menu-open { overflow: hidden; }
</style>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
    display: none;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;

    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-standard),
      overlay var(--duration-base) allow-discrete,
      display var(--duration-base) allow-discrete;
  }
  .mobile-menu[open] { display: flex; opacity: 1; }
  @starting-style { .mobile-menu[open] { opacity: 0; } }
  .mobile-menu::backdrop { background: transparent; }

  /* Staggered entrance for content blocks */
  .mobile-menu__primary li,
  .mobile-menu__services,
  .mobile-menu__contact {
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
    transition-delay: calc(60ms + var(--i, 0) * 45ms);
  }
  @starting-style {
    .mobile-menu[open] .mobile-menu__primary li,
    .mobile-menu[open] .mobile-menu__services,
    .mobile-menu[open] .mobile-menu__contact {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .mobile-menu__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-menu__close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--touch-target);
    margin-right: calc(var(--space-3) * -1);
    padding: 0 var(--space-3);
    background: none;
    border: 0;
    border-radius: var(--radius-pill);
    font-size: var(--size-small);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }
  .mobile-menu__close:hover { background: var(--color-bg-subtle); }

  .mobile-menu__body {
    flex: 1;
    display: grid;
    align-content: start;
    gap: var(--space-7);
    padding-block: var(--space-6) var(--space-7);
  }

  .mobile-menu__primary {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mobile-menu__primary a {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    min-height: var(--touch-target);
    padding-block: var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 1.6rem + 2.4vw, 2.75rem);
    font-weight: var(--weight-medium);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .mobile-menu__primary a[aria-current='page'] { font-style: italic; color: var(--color-text-accent); }
  .mobile-menu__index {
    width: 1.5rem;
    flex: none;
    font-family: var(--font-sans);
    font-size: var(--size-label);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    transform: translateY(-0.35em);
  }

  .mobile-menu__services { border-block: 1px solid var(--color-border); }
  .mobile-menu__services summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    cursor: pointer;
    list-style: none;
  }
  .mobile-menu__services summary::-webkit-details-marker { display: none; }
  .mobile-menu__services[open] .accordion__icon::after { transform: rotate(0deg); }
  .mobile-menu__services ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    column-gap: var(--space-5);
    margin: 0;
    padding: 0 0 var(--space-4);
    list-style: none;
  }
  .mobile-menu__services ul a {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
    font-size: var(--size-body);
    color: var(--color-text);
  }
  .mobile-menu__services ul a:hover { color: var(--color-text-accent); }

  .mobile-menu__contact { display: grid; gap: var(--space-2); justify-items: start; }
  .mobile-menu__contact .link { display: inline-flex; align-items: center; min-height: var(--touch-target); }
  .mobile-menu__phone {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-size: var(--size-h3);
    font-weight: var(--weight-medium);
  }

  .mobile-menu__footer {
    position: sticky;
    bottom: 0;
    padding-block: var(--space-4) max(var(--space-4), env(safe-area-inset-bottom));
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }
</style>
