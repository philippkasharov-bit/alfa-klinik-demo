---
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
import Button from '../ui/Button.astro';
import { clinic } from '../../data/clinic';
import { primaryNav, appointmentCta, isCurrent } from '../../data/navigation';

interface Props {
  /** 'solid' for pages without a hero image; 'overlay' reserved for full-bleed heroes */
  variant?: 'solid' | 'overlay';
}
const { variant = 'solid' } = Astro.props;
const path = Astro.url.pathname;
---
<header class:list={['site-header', `site-header--${variant}`]} data-header>
  <div class="container container--wide site-header__inner">
    <Logo />

    <!-- Desktop (≥ 64rem) -->
    <nav class="site-header__nav" aria-label="Основная навигация">
      <ul role="list">
        {primaryNav.map((item) => (
          <li>
            <a
              class="nav-link t-nav"
              href={item.href}
              aria-current={isCurrent(path, item.href) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone t-num" href={clinic.phone.href}>
        <span class="t-label">Телефон</span>
        <span class="site-header__phone-number">{clinic.phone.display}</span>
      </a>
      <Button href={clinic.phone.href} size="sm" aria-label={`${appointmentCta.labelLong} по телефону ${clinic.phone.display}`}>
        <span class="cta-short t-num">{clinic.phone.display}</span><span class="cta-long">{appointmentCta.labelLong}</span>
      </Button>
    </div>

    <!-- Mobile (< 64rem) -->
    <div class="site-header__mobile">
      <a class="icon-btn" href={clinic.phone.href} aria-label={`Позвонить: ${clinic.phone.display}`}>
        <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
          <path d="M6.6 2.5H4.1c-.9 0-1.6.8-1.5 1.7.8 7 6.7 12.9 13.7 13.7.9.1 1.7-.6 1.7-1.5v-2.5l-3.4-1.4-1.8 1.8a10.6 10.6 0 0 1-4.9-4.9l1.8-1.8L6.6 2.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
        </svg>
      </a>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-label="Открыть меню"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <span class="menu-toggle__label">Меню</span>
        <span class="menu-toggle__lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<MobileMenu id="mobile-menu" />

<script>
  // Hairline + background appear once the page scrolls.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;pointer-events:none';
    document.body.prepend(sentinel);
    new IntersectionObserver(([e]) => header.classList.toggle('is-scrolled', !e.isIntersecting))
      .observe(sentinel);

    // Phones: while the bottom call bar is showing, the header steps aside on scroll-down
    // (only one pinned bar at a time); any scroll-up brings it straight back.
    const MOBILE = window.matchMedia('(max-width: 63.99rem)');
    const callbar = document.querySelector<HTMLElement>('[data-callbar]');
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const dy = y - lastY;
      lastY = y;
      const keep =
        !MOBILE.matches ||
        document.documentElement.classList.contains('menu-open') ||
        header.contains(document.activeElement) ||
        !callbar?.classList.contains('is-visible');
      if (keep || dy < -4) header.classList.remove('is-tucked');
      else if (dy > 4) header.classList.add('is-tucked');
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    header.addEventListener('focusin', () => header.classList.remove('is-tucked'));
    MOBILE.addEventListener('change', update);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--color-bg) 0%, transparent);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard);
  }
  .site-header--solid,
  .site-header.is-scrolled { background: var(--color-bg); }
  .site-header.is-scrolled { border-bottom-color: var(--color-border); }
  .site-header { transition-property: background-color, border-color, transform; }
  .site-header.is-tucked { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) { .site-header { transition: none; } }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    height: var(--header-height);
  }

  /* ---------- Mobile first ---------- */
  .site-header__nav,
  .site-header__actions { display: none; }

  .site-header__mobile {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-right: calc(var(--space-3) * -1); /* optically align icon edge with gutter; matches menu close */
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    background: none;
    border: 0;
    border-radius: var(--radius-pill);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }
  .icon-btn:hover { background: var(--color-bg-subtle); }
  .icon-btn:focus-visible { border-radius: var(--radius-pill); }

  .menu-toggle { padding-inline: var(--space-3); }
  .menu-toggle__label {
    font-size: var(--size-small);
    font-weight: var(--weight-medium);
  }
  .menu-toggle__lines {
    display: grid;
    gap: 5px;
    width: 20px;
  }
  .menu-toggle__lines span {
    display: block;
    height: 1.3px;
    background: currentColor;
  }
  .menu-toggle__lines span:last-child { width: 65%; justify-self: end; }

  /* Hide descriptor on very small screens so the wordmark never wraps */
  /* Phones: the descriptor would wrap to two lines and crowd the bar — wordmark only */
  @media (max-width: 29.99rem) {
    .site-header :global(.logo__descriptor) { display: none; }
  }
  @media (max-width: 23.99rem) {
    .menu-toggle__label { display: none; }
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 64rem) {
    /* 3-column grid so the nav is optically centred on the page,
       independent of logo and action widths */
    .site-header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: var(--space-6);
    }
    .site-header__mobile { display: none; }

    .site-header__nav { display: block; }
    .site-header__nav ul {
      display: flex;
      gap: clamp(1.5rem, 0.2rem + 2.2vw, 2.75rem);
      padding: 0;
      list-style: none;
    }
    .site-header__nav .nav-link { color: var(--color-text); }
    .site-header__nav .nav-link:not([aria-current]):not(:hover) { color: color-mix(in srgb, var(--color-text) 78%, var(--color-bg)); }

    .site-header__actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: var(--space-6);
    }
    .site-header :global(.logo) { justify-self: start; }
    .site-header__actions :global(.btn) { padding-inline: var(--space-5); }
  }

  /* Compact desktop (1024–1279): the separate phone block is hidden, so the button itself
     shows the number — a desktop visitor always sees what the call action is. */
  .cta-long { display: none; }
  @media (min-width: 64rem) and (max-width: 79.99rem) {
    .site-header :global(.logo__descriptor) { display: none; }
  }
  @media (min-width: 80rem) {
    .cta-short { display: none; }
    .cta-long { display: inline; }
  }

  /* Phone number only when there is genuinely room */
  .site-header__phone { display: none; }
  @media (min-width: 80rem) {
    .site-header__phone {
      display: grid;
      gap: 0.1rem;
      min-height: var(--touch-target);
      align-content: center;
      text-align: right;
    }
    .site-header__phone .t-label { line-height: 1; }
    .site-header__phone-number {
      font-size: var(--size-nav);
      font-weight: var(--weight-medium);
      transition: color var(--duration-fast) var(--ease-standard);
    }
    .site-header__phone:hover .site-header__phone-number { color: var(--color-text-accent); }
  }
</style>
