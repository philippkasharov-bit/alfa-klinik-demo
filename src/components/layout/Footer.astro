---
// Site footer — verified facts only (footer + contacts.htm of alfaklinik.ru).
// Same ink background as FinalCta so the two read as one closing band.
import { clinic } from '../../data/clinic';
import { primaryNav, secondaryNav } from '../../data/navigation';

const year = 2026; // source site: «Copyright “Альфа-клиник” 2007-2026»
---
<footer class="footer">
  <div class="container container--wide footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label={`${clinic.name} — на главную`}>
        <span class="footer__mark" aria-hidden="true">α</span>
        <span>{clinic.name}</span>
      </a>
      <p class="footer__tagline">Многопрофильный медицинский центр</p>
    </div>

    <nav class="footer__nav" aria-label="Навигация в подвале">
      <ul role="list">
        {[...primaryNav, ...secondaryNav].map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <address class="footer__contacts">
      <a class="footer__phone t-num" href={clinic.phone.href}>{clinic.phone.display}</a>
      <a href={`mailto:${clinic.email}`}>{clinic.email}</a>
      <span>{clinic.address}</span>
      <span class="t-num">{clinic.hours[0].time} · вс — выходной</span>
    </address>
  </div>

  <div class="container container--wide footer__legal">
    <p>Деятельность осуществляет {clinic.legalName} под брендом {clinic.name}.</p>
    <p class="t-num">© 2007–{year} {clinic.name}</p>
  </div>
</footer>

<style>
  .footer {
    --muted: color-mix(in srgb, var(--color-text-inverse) 62%, transparent);
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
    font-size: var(--size-small);
  }
  .footer :global(:focus-visible) { outline-color: var(--color-text-inverse); }

  .footer__inner {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8) var(--space-7);
    border-top: 1px solid var(--color-border-inverse);
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--touch-target);
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1;
  }
  .footer__mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding-bottom: 0.15rem;
    border: 1px solid var(--color-border-inverse);
    border-radius: 50%;
    font-style: italic;
    font-size: 1.375rem;
    color: var(--color-bg-accent);
  }
  .footer__tagline { margin-top: var(--space-2); color: var(--muted); }

  .footer__nav ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .footer__nav a:hover { color: var(--color-text-inverse); }

  .footer__contacts {
    display: grid;
    gap: 0;
    font-style: normal;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .footer__contacts a { display: inline-flex; align-items: center; min-height: var(--touch-target); color: var(--color-text-inverse); }
  .footer__contacts a:hover { color: var(--color-bg-accent); }
  .footer__phone { font-family: var(--font-display); font-size: 1.625rem; line-height: 1.2; }

  .footer__legal {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5) max(var(--space-6), env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-border-inverse);
    font-size: var(--size-label);
    color: var(--muted);
  }

  @media (min-width: 48rem) {
    .footer__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer__legal { grid-template-columns: 1fr auto; }
  }
  @media (min-width: 64rem) {
    .footer__inner { grid-template-columns: minmax(0, 4fr) minmax(0, 3fr) minmax(0, 4fr); }
    .footer__contacts { justify-items: end; text-align: right; }
  }
</style>
